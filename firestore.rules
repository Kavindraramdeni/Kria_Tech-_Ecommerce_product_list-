rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // -- PRODUCTS --
    function isValidProduct(data) {
      return data.title is string && data.title.size() <= 200 &&
             data.imageSrc is string && data.imageSrc.size() <= 2000 &&
             data.price is number && data.price >= 0 &&
             data.category is string;
    }

    match /products/{productId} {
      allow read: if true; // Publicly viewable
      allow write: if false; 
    }

    match /system/health {
      allow read: if true;
    }

    // -- USERS --
    function isValidUser(data) {
      return data.email is string && data.email.size() <= 255 &&
             data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'createdAt']);

      // CART SUBCOLLECTION
      match /cart/{itemId} {
        allow read, write: if isOwner(userId);
      }
    }

    // -- ORDERS --
    function isValidOrder(data) {
      return data.userId == request.auth.uid &&
             data.items is list &&
             data.totalAmount is number &&
             data.status == 'pending' &&
             data.createdAt == request.time;
    }

    match /orders/{orderId} {
      allow create: if isSignedIn() && isValidOrder(incoming());
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // -- NOTIFICATIONS --
    function isValidNotification(data) {
      return data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.message is string && data.message.size() <= 1000 &&
             data.isRead is bool &&
             data.createdAt == request.time;
    }

    match /notifications/{notificationId} {
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow get, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
